# Copy to backend/.env and fill in. Never commit the real .env.

# --- Security (change both before real use) ---
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
ADMIN_EMAIL=admin@school.edu.in
ADMIN_PASSWORD=choose-a-strong-password

# --- Storage ---
# SQLite by default (backend/data/psa.db). For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/psa
# DATA_DIR=./data

# --- Institution defaults (editable later in Settings) ---
INSTITUTION_NAME=Practice Sheet Agent
TIMEZONE=Asia/Kolkata
SCHEDULER_TIME=06:00
LEAD_DAYS=2

# --- Question generation (Claude) ---
# anthropic = real generation with Claude; offline = questions assembled from PDF sentences (dev/demo only)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_EFFORT=high
# Server-side refusal fallback (re-runs a declined request on Anthropic's recommended model)
LLM_SERVER_FALLBACKS=true

# --- Email, Phase 1 ---
# outbox = write .eml files to data/outbox/email (nothing is sent); smtp = send for real
EMAIL_PROVIDER=outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=Practice Sheets <no-reply@school.edu.in>

# --- WhatsApp, Phase 2 (WhatsApp Business Platform / Cloud API) ---
# outbox = write JSON to data/outbox/whatsapp; cloud_api = send for real
WHATSAPP_PROVIDER=outbox
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_DEFAULT_COUNTRY_CODE=91
# Approved template with a DOCUMENT header and 3 body params: subject, class, exam date
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
# Set to enable delivery receipts at /api/webhooks/whatsapp
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- Worker ---
WORKER_ENABLED=true
WORKER_POLL_SECONDS=10
JOB_MAX_ATTEMPTS=3
DELIVERY_MAX_ATTEMPTS=3
